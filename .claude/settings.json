{
  "outputStyle": "dev",
  "permissions": {
    "allow": [
      "Bash(python ibkr_to_ghostfolio.py*)",
      "Bash(python -c *)",
      "Bash(python -m py_compile *)",
      "Bash(pip install *)",
      "Bash(pip list*)",
      "Bash(git *)",
      "Bash(grep*)",
      "Bash(find . *)",
      "Bash(gh *)",
      "Bash(docker logs ghostfolio*)",
      "Bash(docker inspect ghostfolio*)",
      "Bash(docker exec ghostfolio-ibkr-sync-individual python*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE '^git commit'; then bash .claude/hooks/pre-commit-compile.sh; fi"
          }
        ]
      }
    ]
  }
}
