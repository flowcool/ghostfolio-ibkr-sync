# Copy to .env, replace every placeholder, and keep the file private.
# The shared Docker network must already exist and contain Ghostfolio.

TZ=Europe/Paris
DRY_RUN=true
GHOST_HOST=http://ghostfolio:3333
GHOST_ACCESS_TOKEN=replace-with-your-ghostfolio-security-token
IBKR_TOKEN=replace-with-your-ibkr-flex-token

IBKR_ACCOUNT_IDS_INDIVIDUAL=U1234567
IBKR_QUERY_IDS_INDIVIDUAL=123456
GHOST_ACCOUNT_NAME_INDIVIDUAL=IBKR Individual
CRON_INDIVIDUAL=0 6 * * *

# Remove these three lines if you use one account only and remove the joint service
# from compose.yaml, or fill them for a second IBKR sub-account.
IBKR_ACCOUNT_IDS_JOINT=U7654321
IBKR_QUERY_IDS_JOINT=654321
GHOST_ACCOUNT_NAME_JOINT=IBKR Joint
CRON_JOINT=5 6 * * *

# Compose mounts ./state/individual and ./state/joint as separate private volumes.
# Run simulation to initialize their corporate-action evidence before live imports.
