# Copy to .env. Edit values before enabling financial writes. Keep mode 0600.
TZ=Europe/Paris
DRY_RUN=true
LOG_LEVEL=INFO
APPRISE_URLS=[]
APPRISE_TIMEOUT=10

# Use an existing network containing Ghostfolio and a service name/alias on it.
GHOST_DOCKER_NETWORK=ghostfolio
GHOST_HOST=http://ghostfolio:3333
GHOST_ACCESS_TOKEN=replace-with-your-ghostfolio-security-token
IBKR_TOKEN=replace-with-your-ibkr-flex-token

IBKR_ACCOUNT_IDS_INDIVIDUAL=U1234567
IBKR_QUERY_IDS_INDIVIDUAL=123456
GHOST_ACCOUNT_NAME_INDIVIDUAL=IBKR Individual
CRON_INDIVIDUAL=0 6 * * *

# Compose mounts ./state/individual at /state. Initialize it in simulation.
# For a second account, see docs/getting-started.md#multiple-accounts.
# Docker run needs a separate .env.run; this file is for Compose interpolation.
