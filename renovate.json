{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "forkProcessing": "enabled",
  "enabledManagers": ["pip_requirements", "pep621", "github-actions", "dockerfile", "docker-compose"],
  "timezone": "Europe/Zurich",
  "schedule": ["* * * * 1"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "ignoreUnstable": true,
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "ignoreDeps": ["ghcr.io/flowcool/ghostfolio-ibkr-sync", "ghostfolio-ibkr-sync"],
  "packageRules": [
    {
      "description": "Keep the complete pinned Python dependency closure together after the review window.",
      "matchManagers": ["pip_requirements", "pep621"],
      "minimumReleaseAge": "14 days",
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-minor-patch"
    },
    {
      "description": "Preserve the review window for image and CI changes.",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "minimumReleaseAge": "3 days",
      "pinDigests": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags", "github-digest"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github-actions"
    },
    {
      "description": "Python interpreter migration is a separate reviewed change.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.14(?:\\.|-|$)/"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["python"],
      "allowedVersions": ">=3.14 <3.15"
    },
    {
      "description": "Python interpreter migrations remain a separate reviewed change.",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Major upgrades require approval before creating a branch or PR.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": false
}
